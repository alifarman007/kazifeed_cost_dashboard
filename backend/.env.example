# PostgreSQL (iDempiere) connection
PGHOST=172.16.253.172
PGPORT=5555
PGUSER=adempiere
PGPASSWORD=CHANGE_ME
PGDATABASE=kfg_idempiere

# Pool tuning
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=60000

# Cache TTL (seconds)
CACHE_TTL=900

# CORS: comma separated origins
CORS_ORIGINS=http://localhost:3010
